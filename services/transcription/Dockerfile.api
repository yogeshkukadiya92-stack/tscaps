FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi==0.115.12 uvicorn==0.34.2 httpx==0.28.1 numpy==2.2.6
# Gujarati uses OpenAI text plus genuine acoustic forced alignment. Bake the
# aligner into the image: requests never download models or depend on HF uptime.
RUN pip install --no-cache-dir torch==2.6.0 torchaudio==2.6.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir stable-ts==2.19.1 faster-whisper==1.2.1
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download('mobiuslabsgmbh/faster-whisper-large-v3-turbo', revision='0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf', local_dir='/models/aligner', allow_patterns=['config.json', 'model.bin', 'tokenizer.json', 'vocabulary.*'])"
COPY services/transcription/*.py ./
RUN useradd -m worker && mkdir /budget && chown worker /budget
USER worker
ENV TRANSCRIPTION_PROVIDER=groq GROQ_MODEL=whisper-large-v3 GROQ_MONTHLY_USD_LIMIT=5 API_ROOT_PATH=/processing
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "8", "--no-access-log"]
