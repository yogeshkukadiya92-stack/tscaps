FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi==0.115.12 uvicorn==0.34.2 httpx==0.28.1 numpy==2.2.6 playwright==1.58.0 && playwright install --with-deps chromium
COPY services/transcription/*.py ./
RUN useradd -m worker
ENV ENABLE_TRANSCRIPTION=false ENABLE_SERVER_RENDER=true
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "8", "--no-access-log"]
