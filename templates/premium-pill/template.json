{
  "name": "Pill",
  "category": "premium-captions",
  "addedOn": "2026-10-16",
  "typography": {
    "fontStack": "inter",
    "fontSize": 4.2,
    "fontWeight": 800,
    "textCase": "uppercase",
    "textAlign": "center",
    "wordSpacing": 0.08,
    "lineSpacing": 0.12
  },
  "styleControls": [
    {
      "id": "primary-color",
      "default": "#e5efc7",
      "label": "Text",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "default": "#e5efc7",
      "label": "Accent",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "bg-color",
      "default": "#5a7040",
      "label": "Background",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "bg-radius",
      "label": "Background radius",
      "type": "float",
      "default": 2,
      "min": 0,
      "max": 3,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "highlight-bg-color",
      "label": "Active word background",
      "type": "color",
      "default": "#5a7040",
      "group": "style",
      "subgroup": "colors"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "limit_by_words",
      "maxWords": 1
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 30
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 2,
    "maxWidthRatio": 0.78
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.7,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ],
  "variants": [
    {
      "label": "Original",
      "overrides": {
        "highlight-color": "#e5efc7"
      }
    },
    {
      "label": "Ice",
      "overrides": {
        "highlight-color": "#7fd3ff"
      }
    },
    {
      "label": "Rose",
      "overrides": {
        "highlight-color": "#ff8fc7"
      }
    }
  ]
}
