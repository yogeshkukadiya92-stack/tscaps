{
  "name": "Creator 4",
  "category": "premium-captions",
  "addedOn": "2026-10-16",
  "typography": {
    "fontStack": "inter",
    "fontSize": 3.5,
    "fontWeight": 800,
    "textCase": "none",
    "textAlign": "center",
    "wordSpacing": 0.08,
    "lineSpacing": 0.04
  },
  "styleControls": [
    {
      "id": "primary-color",
      "default": "#ffffff",
      "label": "Text",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "default": "#ffbc24",
      "label": "Accent",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "big-word-font-family",
      "default": "dancing-script",
      "label": "Accent font",
      "type": "font",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "limit_by_words",
      "maxWords": 4
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 30
    }
  ],
  "lineSplitter": {
    "type": "isolated-word",
    "minLetters": 2,
    "minSecondsOnScreen": 0.45,
    "fallbackMinSecondsOnScreen": 0.15
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.58,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ],
  "variants": [
    {
      "label": "Original",
      "overrides": {
        "highlight-color": "#ffbc24"
      }
    },
    {
      "label": "Ice",
      "overrides": {
        "highlight-color": "#7fd3ff"
      }
    },
    {
      "label": "Rose",
      "overrides": {
        "highlight-color": "#ff8fc7"
      }
    }
  ]
}
