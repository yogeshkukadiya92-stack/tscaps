{
  "name": "Linen",
  "category": "dynamic",
  "addedOn": "2026-10-14",
  "typography": {
    "fontStack": "bricolage-grotesque",
    "fontSize": 3.7,
    "fontWeight": 700,
    "textCase": "none",
    "textAlign": "center",
    "wordSpacing": 0.08,
    "lineSpacing": 0.12
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Accent",
      "type": "color",
      "default": "#b9e0e6",
      "group": "style",
      "subgroup": "colors"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "limit_by_words",
      "maxWords": 5
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 34
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 2,
    "maxWidthRatio": 0.76
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.69,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "rendering": {
    "splitWordsIntoLetters": true
  },
  "variants": [
    {
      "label": "Original",
      "overrides": {
        "highlight-color": "#b9e0e6"
      }
    },
    {
      "label": "Ice",
      "overrides": {
        "highlight-color": "#7fd3ff"
      }
    },
    {
      "label": "Coral",
      "overrides": {
        "highlight-color": "#ff897a"
      }
    }
  ]
}
