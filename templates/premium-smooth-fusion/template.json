{
  "name": "Smooth Fusion",
  "category": "premium-captions",
  "addedOn": "2026-10-16",
  "typography": {
    "fontStack": "montserrat",
    "fontSize": 3.4,
    "fontWeight": 800,
    "textCase": "none",
    "textAlign": "center",
    "wordSpacing": 0.08,
    "lineSpacing": 0.12
  },
  "styleControls": [
    {
      "id": "primary-color",
      "default": "#ffc4dc",
      "label": "Text",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "default": "#a8db32",
      "label": "Accent",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "limit_by_words",
      "maxWords": 5
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 44
    }
  ],
  "lineSplitter": {
    "type": "isolated-word",
    "minLetters": 2,
    "minSecondsOnScreen": 0.45,
    "fallbackMinSecondsOnScreen": 0.15
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.7,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ],
  "variants": [
    {
      "label": "Original",
      "overrides": {
        "highlight-color": "#a8db32"
      }
    },
    {
      "label": "Ice",
      "overrides": {
        "highlight-color": "#7fd3ff"
      }
    },
    {
      "label": "Rose",
      "overrides": {
        "highlight-color": "#ff8fc7"
      }
    }
  ]
}
