{
  "name": "Fireline",
  "category": "multiline",
  "addedOn": "2026-10-14",
  "typography": {
    "fontStack": "kalam",
    "fontSize": 3.7,
    "fontWeight": 500,
    "textCase": "none",
    "textAlign": "center",
    "wordSpacing": 0.08,
    "lineSpacing": 0.12
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Accent",
      "type": "color",
      "default": "#ffc200",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "big-word-font-family",
      "label": "Hero font",
      "type": "font",
      "default": "anton",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "limit_by_words",
      "maxWords": 4
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 34
    }
  ],
  "lineSplitter": {
    "type": "isolated-word",
    "minLetters": 3,
    "minSecondsOnScreen": 0.45,
    "fallbackMinSecondsOnScreen": 0.2
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.53,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "variants": [
    {
      "label": "Original",
      "overrides": {
        "highlight-color": "#ffc200"
      }
    },
    {
      "label": "Ice",
      "overrides": {
        "highlight-color": "#7fd3ff"
      }
    },
    {
      "label": "Coral",
      "overrides": {
        "highlight-color": "#ff897a"
      }
    }
  ]
}
