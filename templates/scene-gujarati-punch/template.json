{
  "name": "Gujarati Punch",
  "category": "desi",
  "addedOn": "2026-10-22",
  "typography": {
    "fontStack": "poppins",
    "fontSize": 3.6,
    "fontWeight": 900,
    "textCase": "none",
    "textAlign": "center",
    "wordSpacing": 0.08,
    "lineSpacing": 0.02
  },
  "styleControls": [
    {
      "id": "primary-color",
      "default": "#ffffff",
      "label": "Text",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "default": "#ff8500",
      "label": "Accent",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "quote-color",
      "default": "#f4edac",
      "label": "Quote",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "limit_by_words",
      "maxWords": 5
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 30
    }
  ],
  "lineSplitter": {
    "type": "fixed-tail",
    "tailWordCount": 2,
    "minWordsToSplit": 3
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.59,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ],
  "variants": [
    {
      "label": "Original",
      "overrides": {
        "highlight-color": "#ff8500",
        "quote-color": "#f4edac"
      }
    }
  ]
}
