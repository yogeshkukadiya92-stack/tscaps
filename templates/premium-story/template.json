{
  "name": "Story",
  "category": "premium-captions",
  "addedOn": "2026-10-16",
  "typography": {
    "fontStack": "playfair-display",
    "fontSize": 3.2,
    "fontWeight": 500,
    "textCase": "none",
    "textAlign": "center",
    "wordSpacing": 0.08,
    "lineSpacing": 0.04
  },
  "styleControls": [
    {
      "id": "primary-color",
      "default": "#ffffff",
      "label": "Text",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "default": "#e92b47",
      "label": "Accent",
      "type": "color",
      "group": "style",
      "subgroup": "colors"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "limit_by_words",
      "maxWords": 5
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 30
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 2,
    "maxLines": 2,
    "maxWidthRatio": 0.78
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.58,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ],
  "variants": [
    {
      "label": "Original",
      "overrides": {
        "highlight-color": "#e92b47"
      }
    },
    {
      "label": "Ice",
      "overrides": {
        "highlight-color": "#7fd3ff"
      }
    },
    {
      "label": "Rose",
      "overrides": {
        "highlight-color": "#ff8fc7"
      }
    }
  ]
}
